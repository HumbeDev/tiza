{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiza",
  "version": "0.2.0",
  "identifier": "dev.humbe.tiza",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tiza",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src tizasim: http://tizasim.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tiza"
        ],
        "name": "Tiza presentation",
        "description": "Tiza presentation",
        "mimeType": "application/x-tiza",
        "role": "Editor"
      }
    ],
    "shortDescription": "Offline presentations with LaTeX, media and HTML simulations",
    "category": "Education",
    "publisher": "Humberto Daniel Lage Rodríguez",
    "copyright": "© 2026 Humberto Daniel Lage Rodríguez — MIT OR Apache-2.0",
    "homepage": "https://github.com/HumbeDev/tiza"
  }
}
